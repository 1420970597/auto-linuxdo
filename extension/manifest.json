{
  "manifest_version": 3,
  "name": "Linux.do 会话同步",
  "version": "2.0.0",
  "description": "通过 HTTPS 将当前 Chrome 的 Linux.do 会话同步到预配置的服务器。",
  "permissions": ["cookies", "storage", "alarms"],
  "optional_host_permissions": ["https://linux.do/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "sync.html"}
}
